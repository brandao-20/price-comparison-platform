@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IConfiguration Configuration

@if (mapLoadFailed)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div id="@MapElementId" style="width:100%; height:100%;"></div>
}

@code {
    [Parameter]
    public decimal Latitude { get; set; } = 0m;

    [Parameter]
    public decimal Longitude { get; set; } = 0m;

    [Parameter]
    public EventCallback<(decimal lat, decimal lng, string address)> OnMapClick { get; set; }

    [Parameter]
    public EventCallback<string> OnMapInitialized { get; set; }

    private DotNetObjectReference<GoogleMap>? _objectRef;
    private string MapElementId = $"map_{Guid.NewGuid():N}";
    private bool mapLoadFailed = false;
    private string errorMessage = "Erro ao carregar o mapa. Verifique a conexão ou tente novamente.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                await WaitForMapsInterop();

                var apiKey = Configuration["GoogleMapsApiKey"];
                if (string.IsNullOrWhiteSpace(apiKey))
                {
                    mapLoadFailed = true;
                    errorMessage = "Google Maps is not configured.";
                    StateHasChanged();
                    return;
                }

                await JS.InvokeVoidAsync("mapsInterop.loadGoogleMaps", apiKey);

                await WaitForGoogleMaps();

                _objectRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync(
                    "mapsInterop.initMapaLojaClick",
                    Latitude,
                    Longitude,
                    MapElementId,
                    _objectRef
                );

                await OnMapInitialized.InvokeAsync(MapElementId);
            }
            catch (JSException)
            {
                mapLoadFailed = true;
                errorMessage = "Google Maps could not be loaded. Please try again later.";
                Console.Error.WriteLine("Google Maps initialization failed.");
                StateHasChanged();
            }
        }
    }

    private async Task WaitForMapsInterop()
    {
        int attempts = 0;
        const int maxAttempts = 200;
        while (true)
        {
            try
            {
                bool isUndefined = await JS.InvokeAsync<bool>("eval", "typeof window.mapsInterop === 'undefined' || typeof window.mapsInterop.loadGoogleMaps === 'undefined'");
                if (!isUndefined)
                {
                    break;
                }

                if (attempts++ >= maxAttempts)
                {
                    throw new JSException("Timeout: mapsInterop não foi carregado.");
                }
                await Task.Delay(100);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
                if (attempts++ >= maxAttempts)
                {
                    throw new JSException("Timeout: mapsInterop não foi carregado. Erro: " + ex.Message);
                }
                await Task.Delay(100);
            }
        }
    }

    private async Task WaitForGoogleMaps()
    {
        int attempts = 0;
        const int maxAttempts = 200;
        while (await JS.InvokeAsync<bool>("eval", "typeof google === 'undefined' || typeof google.maps === 'undefined' || !window.googleMapsLoaded"))
        {
            if (attempts++ >= maxAttempts)
            {
                throw new JSException("Timeout: Google Maps API não carregou.");
            }
            await Task.Delay(100);
        }
    }

    [JSInvokable]
    public async Task SetCoordinatesWithAddress(double lat, double lng, string address)
    {
        decimal dLat = (decimal)lat;
        decimal dLng = (decimal)lng;
        if (OnMapClick.HasDelegate)
        {
            await OnMapClick.InvokeAsync((dLat, dLng, address));
        }
    }

    public void Dispose()
    {
        _objectRef?.Dispose();
    }
}
