@inherits LayoutComponentBase
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject Microsoft.AspNetCore.SignalR.Client.HubConnection Notifications
@using WebApp.Models
@using WebApp.Pages.ChatBot

<div class="page">
    <div class="sidebar">
        @if (AuthService.IsLoggedIn)
        {
            @if (string.Equals(AuthService.Role, "ADMIN", StringComparison.OrdinalIgnoreCase))
            {
                <NavMenuAdmin />
            }
            else if (string.Equals(AuthService.Role, "USERMANAGER", StringComparison.OrdinalIgnoreCase))
            {
                <NavMenuManager />
            }
            else
            {
                <NavMenuUser />
            }
        }
        else
        {
            <!-- Se não estiver com login efetuado exibe o NavMenuUser -->
            <NavMenuUser />
        }
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end">
            @if (AuthService.IsLoggedIn)
            {
                <span class="welcome-text me-3">Bem-vindo, @AuthService.UserName!</span>
                <a href="/profile" class="btn btn-outline-primary me-2">Perfil</a>
                <button class="btn btn-outline-secondary" @onclick="HandleLogout">Logout</button>
            }
            else
            {
                <button class="btn btn-outline-primary me-2" @onclick="GoLogin">Login</button>
                <button class="btn btn-outline-success" @onclick="GoRegister">Registar</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        AuthService.Clear();
        await Notifications.StopAsync();
        Navigation.NavigateTo("/");
    }

    private void GoLogin() => Navigation.NavigateTo("/login");
    private void GoRegister() => Navigation.NavigateTo("/register");
}
