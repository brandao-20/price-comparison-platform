@page "/prices"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<h2>Gerir Preços</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para gerir preços.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando preços...</p>
}
else if (precos == null || !precos.Any())
{
    <p>Nenhum preço registrado.</p>
}
else
{
    <p>Aqui você pode listar e gerenciar os preços dos produtos.</p>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Produto</th>
                <th>Loja</th>
                <th>Preço</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in precos)
            {
                <tr>
                    <td>@p.RegistoId</td>
                    <td>@p.ProdutoNome</td>
                    <td>@p.LojaNome</td>
                    <td>@p.Preco.ToString("C")</td>
                    <td>@p.DataRegisto.ToString("dd/MM/yyyy")</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmarExclusao(p.RegistoId))">Remover</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<!-- Popup de Confirmação para Exclusão -->
@if (showConfirmPopup)
{
    <div class="confirm-overlay">
        <div class="confirm-content">
            <h5 style="color: #d32f2f;">Confirmação</h5>
            <p style="color: #333;">Deseja remover o registo de preço com ID "@registoIdToDelete"?</p>
            <div class="confirm-buttons">
                <button class="btn btn-danger" @onclick="Excluir">Sim</button>
                <button class="btn btn-secondary" @onclick="FecharConfirmPopup">Não</button>
            </div>
        </div>
    </div>
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }
</style>

@code {
    private List<RegistoPrecoModel>? precos;
    private bool isInitialized = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool showConfirmPopup = false;
    private int? registoIdToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthService.IsAdmin && !AuthService.IsManager)
        {
            Navigation.NavigateTo("/homeadmin");
            return;
        }

        await CarregarPrecos();
    }

    private async Task CarregarPrecos()
    {
        try
        {
            var response = await Http.GetAsync("api/RegistosPrecos");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<RegistoPrecoModel>>>();
                if (apiResponse?.Success == true)
                {
                    precos = apiResponse.Data ?? new List<RegistoPrecoModel>();
                }
                else
                {
                    precos = new List<RegistoPrecoModel>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os preços.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                precos = new List<RegistoPrecoModel>();
                ShowPopup("Erro ao carregar os preços. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            precos = new List<RegistoPrecoModel>();
            ShowPopup($"Erro inesperado ao carregar os preços: {ex.Message}", MessagePopup.MessageType.Error);
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ConfirmarExclusao(int registoId)
    {
        registoIdToDelete = registoId;
        showConfirmPopup = true;
    }

    private void FecharConfirmPopup()
    {
        showConfirmPopup = false;
        registoIdToDelete = null;
    }

    private async Task Excluir()
    {
        if (registoIdToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/RegistosPrecos/{registoIdToDelete}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                if (apiResponse?.Success == true)
                {
                    ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
                    await CarregarPrecos();
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? $"Erro ao remover o registo de preço com ID {registoIdToDelete}.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                ShowPopup($"Erro ao remover o registo de preço com ID {registoIdToDelete}. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao remover o registo de preço: {ex.Message}", MessagePopup.MessageType.Error);
        }

        FecharConfirmPopup();
    }

    private void GoBack() => Navigation.NavigateTo("/homeadmin");

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class RegistoPrecoModel
    {
        public int RegistoId { get; set; }
        public int ProdutoId { get; set; }
        public string ProdutoNome { get; set; } = "";
        public int LojaId { get; set; }
        public string LojaNome { get; set; } = "";
        public decimal Preco { get; set; }
        public DateTime DataRegisto { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
