@page "/login"
@using System.Net.Http.Json
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@using WebApp.Components
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject WebApp.Services.AuthService AuthService

<PageTitle>Login</PageTitle>
<h3>Login</h3>

<EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Username:</label>
        <InputText class="form-control" @bind-Value="loginRequest.Username" />
    </div>
    <div class="mb-3">
        <label>Password:</label>
        <InputText type="password" class="form-control" @bind-Value="loginRequest.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>

<hr />
<button class="btn btn-danger" @onclick="LoginWithGoogle">Login com Google</button>

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private LoginRequest loginRequest = new();
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        var error = query["error"];
        var code = query["code"];
        if (!string.IsNullOrEmpty(error) || !string.IsNullOrEmpty(code))
            Navigation.NavigateTo("/login", replace: true);

        if (!string.IsNullOrEmpty(error))
        {
            await JS.InvokeAsync<string?>("oauthLogin.takeVerifier");
            ShowPopup("Google login is unavailable or was cancelled. Please try again.", MessagePopup.MessageType.Error);
        }
        else if (!string.IsNullOrEmpty(code))
        {
            try
            {
                var verifier = await JS.InvokeAsync<string?>("oauthLogin.takeVerifier");
                if (string.IsNullOrEmpty(verifier))
                    throw new InvalidOperationException("The login request has expired.");
                using var response = await Http.PostAsJsonAsync("api/ExternalLogin/exchange", new { Code = code, Verifier = verifier });
                response.EnsureSuccessStatusCode();
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (string.IsNullOrEmpty(result?.Token))
                    throw new InvalidOperationException("The login response is invalid.");
                await HandleGoogleLogin(result.Token);
            }
            catch (Exception)
            {
                AuthService.Clear();
                await LocalStorage.RemoveItemAsync("authToken");
                ShowPopup("Google login could not be completed. Start the login again.", MessagePopup.MessageType.Error);
            }
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", loginRequest);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<LoginResponse>>();
                if (apiResponse?.Success == true && apiResponse.Data != null)
                {
                    var result = apiResponse.Data;
                    // Armazena o token e role retornados
                    AuthService.Token = result.Token;
                    AuthService.Role = result.Role;

                    // Salva o token no localStorage
                    await LocalStorage.SetItemAsync("authToken", result.Token);

                    // Decodifica o token JWT para extrair os claims
                    var handler = new JwtSecurityTokenHandler();
                    var jwt = handler.ReadJwtToken(result.Token);

                    // Extrai o nome (claim de ClaimTypes.Name)
                    var nameClaim = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
                    if (!string.IsNullOrEmpty(nameClaim))
                    {
                        AuthService.UserName = nameClaim;
                    }
                    else
                    {
                        AuthService.UserName = loginRequest.Username;
                    }

                    // Extrai o "utilizadorId" para que o front-end saiba qual conta está logada
                    var userIdClaim = jwt.Claims.FirstOrDefault(c => c.Type == "utilizadorId")?.Value;
                    if (int.TryParse(userIdClaim, out int userId))
                    {
                        AuthService.UserId = userId;
                    }

                    ShowPopup("Login realizado com sucesso!", MessagePopup.MessageType.Success);

                    // Redireciona conforme o papel do usuário
                    if (result.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                        Navigation.NavigateTo("/homeadmin");
                    else if (result.Role.Equals("UserManager", StringComparison.OrdinalIgnoreCase))
                        Navigation.NavigateTo("/homeusermanager");
                    else
                        Navigation.NavigateTo("/homeuser");
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao fazer login.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<LoginResponse>>();
                ShowPopup(apiResponse?.Message ?? "Credenciais inválidas. Verifique seu username e senha.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao fazer login: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private async Task HandleGoogleLogin(string googleToken)
    {
        try
        {
            AuthService.Token = googleToken;
            if (!AuthService.ValidateToken())
                throw new InvalidOperationException("The login token is invalid or expired.");
            await LocalStorage.SetItemAsync("authToken", googleToken);

            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(googleToken);

            var nameClaim = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
            if (!string.IsNullOrEmpty(nameClaim))
            {
                AuthService.UserName = nameClaim;
            }

            var roleClaim = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
            if (!string.IsNullOrEmpty(roleClaim))
            {
                AuthService.Role = roleClaim;
            }

            var userIdClaim = jwt.Claims.FirstOrDefault(c => c.Type == "utilizadorId")?.Value;
            if (int.TryParse(userIdClaim, out int userId))
            {
                AuthService.UserId = userId;
            }

            ShowPopup("Login com Google realizado com sucesso!", MessagePopup.MessageType.Success);

            if (AuthService.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo("/homeadmin");
            else if (AuthService.Role.Equals("UserManager", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo("/homeusermanager");
            else
                Navigation.NavigateTo("/homeuser");
        }
        catch (Exception)
        {
            AuthService.Clear();
            await LocalStorage.RemoveItemAsync("authToken");
            ShowPopup("Google login could not be completed. Please try again.", MessagePopup.MessageType.Error);
        }
    }

    private async Task LoginWithGoogle()
    {
        var challenge = await JS.InvokeAsync<string>("oauthLogin.begin");
        var url = new Uri(Http.BaseAddress!, $"api/ExternalLogin/Google?challenge={Uri.EscapeDataString(challenge)}");
        Navigation.NavigateTo(url.AbsoluteUri, forceLoad: true);
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class LoginRequest
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
        public string Role { get; set; } = "";
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
