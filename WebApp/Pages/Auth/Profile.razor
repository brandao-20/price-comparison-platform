@page "/profile"
@using WebApp.Components
@using WebApp.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<h3>Perfil do Utilizador</h3>

@if (!AuthService.IsLoggedIn)
{
    <p>Você precisa estar logado para visualizar esta página.</p>
    <button class="btn btn-primary" @onclick="NavigateToLogin">Ir para Login</button>
}
else
{
    <p><strong>Nome de Utilizador:</strong> @AuthService.UserName</p>
    <p><strong>Papel (Role):</strong> @AuthService.Role</p>
    <p><strong>Pontos:</strong> @userPontos</p>

    <h4 class="mt-4">Ranking de Utilizadores</h4>
    @if (ranking == null)
    {
        <p>Carregando ranking...</p>
    }
    else if (!ranking.Any())
    {
        <p>Nenhum utilizador no ranking.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Posição</th>
                    <th>Username</th>
                    <th>Pontos</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < ranking.Count; i++)
                {
                    var u = ranking[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@u.Username</td>
                        <td>@u.Pontos</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a href="/favorites" class="btn btn-info mt-3">Ver Produtos Favoritos</a>
    <button class="btn btn-warning mt-3" @onclick="AskDelete">Eliminar Conta</button>

    <!-- Popup para mensagens -->
    <MessagePopup
        IsVisible="@showPopup"
        Message="@popupMessage"
        Type="@popupType"
        OnClose="ClosePopup" />

    <!-- Popup de Confirmação para Exclusão -->
    @if (showConfirm)
    {
        <div class="confirm-overlay">
            <div class="confirm-content">
                <h5 style="color: #d32f2f;">Confirmação</h5>
                <p style="color: #333;">Tem certeza de que deseja eliminar a sua conta? Esta ação é irreversível.</p>
                <div class="confirm-buttons">
                    <button class="btn btn-danger" @onclick="DeleteAccount">Sim, eliminar</button>
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                </div>
            </div>
        </div>
    }
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }
</style>

@code {
    private bool showConfirm = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private int userPontos = 0;
    private List<RankingDto> ranking = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            // The authenticated account can read its own profile and points.
            var profile = await Http.GetFromJsonAsync<Utilizador>($"api/Utilizadores/{AuthService.UserId}");
            userPontos = profile?.Pontos ?? 0;

            // Carregar ranking (apenas para Admins)
            if (AuthService.IsAdmin)
            {
                var rankingResponse = await Http.GetAsync("api/Utilizadores/ranking");
                if (rankingResponse.IsSuccessStatusCode)
                {
                    var rankingApiResponse = await rankingResponse.Content.ReadFromJsonAsync<ApiResponse<List<RankingDto>>>();
                    if (rankingApiResponse?.Success == true)
                    {
                        ranking = rankingApiResponse.Data ?? new List<RankingDto>();
                    }
                }
                else
                {
                    Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao carregar dados do perfil: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void AskDelete() => showConfirm = true;
    private void CancelDelete() => showConfirm = false;

    private async Task DeleteAccount()
    {
        try
        {
            var response = await Http.DeleteAsync("api/Utilizadores/me");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                if (apiResponse?.Success == true)
                {
                    ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
                    AuthService.Clear();
                    Navigation.NavigateTo("/");
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao remover a conta.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                ShowPopup(apiResponse?.Message ?? "Erro ao remover a conta. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao remover a conta: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }

        showConfirm = false;
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }

    private class RankingDto
    {
        public int UtilizadorId { get; set; }
        public string Username { get; set; } = string.Empty;
        public int Pontos { get; set; }
    }
}
