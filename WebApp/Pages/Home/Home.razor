@page "/"
@inject NavigationManager NavManager
@inject WebApp.Services.AuthService AuthService
@using WebApp.Pages.ChatBot

<div style="position: relative; min-height: calc(100vh - 3.5rem);">

    @if (AuthService.IsLoggedIn)
    {
        RedirectToHome();
    }
    else
    {
        <h1>Bem-vindo à Plataforma de Comparação de Preços!</h1>
        <p>Aqui você pode pesquisar produtos sem login, ou efetuar login para mais funcionalidades.</p>
        <p>Precisa de ajuda? Clique no <b>Assistente de Preços</b> no canto inferior direito! 🤖</p>
    }

    <Chatbot />
</div>

@code {

    protected override void OnInitialized()
    {
        if (AuthService.IsLoggedIn)
            RedirectToHome();
    }

    private void RedirectToHome()
    {
        if (AuthService.IsAdmin)
            NavManager.NavigateTo("/homeadmin");
        else if (AuthService.IsManager)
            NavManager.NavigateTo("/homeusermanager");
        else
            NavManager.NavigateTo("/homeuser");
    }
}
