@page "/homeadmin"
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation

<h1>Bem-vindo, @AuthService.UserName! (Admin)</h1>
<p>Você tem acesso completo ao sistema. Gira utilizadores, lojas, categorias, produtos, relatórios e mensagens.</p>

@code {
    protected override void OnInitialized()
    {
        if (!AuthService.ValidateToken() || !AuthService.IsAdmin)
            Navigation.NavigateTo("/login");
    }
}
