@page "/products/new"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Criar Produto</PageTitle>

<style>
    .subcategory-container {
        opacity: 0;
        transform: translateY(-10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .subcategory-container.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .form-select {
        max-width: 300px;
    }
</style>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para criar produtos.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando categorias...</p>
}
else
{
    <h3>Criar Produto</h3>
    <EditForm Model="novoProduto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nome:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Nome" />
        </div>
        <div class="mb-3">
            <label>Marca:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Marca" />
        </div>
        <div class="mb-3">
            <label>Descrição:</label>
            <InputText class="form-control" @bind-Value="novoProduto.Descricao" />
        </div>
        <div class="mb-3">
            <label>Categoria:</label>
            @if (!parentCategorias.Any())
            {
                <p class="text-danger">Nenhuma categoria disponível. Por favor, crie uma categoria primeiro.</p>
            }
            else
            {
                <select class="form-select" @bind="selectedParentCategoriaId" @bind:event="onchange">
                    @foreach (var cat in parentCategorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nome</option>
                    }
                </select>
            }
        </div>
        @if (subCategorias.Any())
        {
            <div class="mb-3 subcategory-container visible">
                <label>Subcategoria:</label>
                <select class="form-select" @bind="selectedSubCategoriaId">
                    <option value="0">Nenhuma subcategoria</option>
                    @foreach (var subCat in subCategorias)
                    {
                        <option value="@subCat.CategoriaId">@subCat.NomeExibicao</option>
                    }
                </select>
                @if (selectedSubCategoriaId != 0)
                {
                    var selectedSubCat = subCategorias.FirstOrDefault(c => c.CategoriaId == selectedSubCategoriaId);
                    <p class="mt-2 text-muted">Subcategoria selecionada: @(selectedSubCat?.NomeExibicao?.TrimStart(' ', '└') ?? "Desconhecida")</p>
                }
            </div>
        }
        <button type="submit" class="btn btn-primary" disabled="@(!parentCategorias.Any())">Criar Produto</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private Produto novoProduto = new();
    private List<Categoria> categorias = new();
    private List<Categoria> parentCategorias = new();
    private List<CategoriaSubcategorias> subCategorias = new();
    private int selectedParentCategoriaId = 0;
    private int selectedSubCategoriaId = 0;
    private bool isInitialized = false;
    private bool shouldRedirect = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                var response = await Http.GetAsync("api/Categorias");
                if (response.IsSuccessStatusCode)
                {
                    var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                    if (apiResponse?.Success == true)
                    {
                        categorias = apiResponse.Data ?? new List<Categoria>();
                        parentCategorias = categorias.Where(c => c.ParentId == null).OrderBy(c => c.Nome).ToList();
                        // Define a primeira categoria pai como padrão, se disponível
                        if (parentCategorias.Any())
                        {
                            selectedParentCategoriaId = parentCategorias.First().CategoriaId;
                            await OnParentCategoriaChanged(new ChangeEventArgs { Value = selectedParentCategoriaId.ToString() });
                        }
                    }
                    else
                    {
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar as categorias.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
            catch (Exception ex)
            {
                ShowPopup($"Erro inesperado ao carregar as categorias: {ex.Message}", MessagePopup.MessageType.Error);
            }
            finally
            {
                isInitialized = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnParentCategoriaChanged(ChangeEventArgs e)
    {
        selectedParentCategoriaId = int.Parse(e.Value?.ToString() ?? "0");
        selectedSubCategoriaId = 0; // Resetar a subcategoria ao mudar a categoria pai
        subCategorias.Clear();

        if (selectedParentCategoriaId != 0)
        {
            var selectedParent = categorias.FirstOrDefault(c => c.CategoriaId == selectedParentCategoriaId);
            if (selectedParent != null)
            {
                if (selectedParent.SubCategorias?.Any() == true)
                {
                    subCategorias = CategoriaSubcategorias.Achatadas(selectedParent.SubCategorias);
                }
                else
                {
                    subCategorias.Clear();
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(novoProduto.Nome))
        {
            ShowPopup("O nome do produto é obrigatório.", MessagePopup.MessageType.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(novoProduto.Marca))
        {
            ShowPopup("A marca do produto é obrigatória.", MessagePopup.MessageType.Error);
            return;
        }

        if (selectedParentCategoriaId == 0)
        {
            ShowPopup("Selecione uma categoria válida.", MessagePopup.MessageType.Error);
            return;
        }

        try
        {
            // Usa a subcategoria se selecionada, caso contrário usa a categoria pai
            novoProduto.CategoriaId = selectedSubCategoriaId != 0 ? selectedSubCategoriaId : selectedParentCategoriaId;
            novoProduto.Categoria = null;


            var response = await Http.PostAsJsonAsync("api/Produtos", novoProduto);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<Produto>>();

            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                shouldRedirect = true;
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
            }
            else
            {
                ShowPopup(apiResponse?.Message ?? "Erro ao criar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao criar o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo($"/products?successMessage={Uri.EscapeDataString("Produto criado com sucesso!")}");
            shouldRedirect = false;
        }
    }

    private void Voltar() => Navigation.NavigateTo("/products");

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
