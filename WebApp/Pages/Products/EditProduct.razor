@page "/products/edit/{id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Editar Produto</PageTitle>

<style>
    .subcategory-container {
        opacity: 0;
        transform: translateY(-10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .subcategory-container.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .form-select {
        max-width: 300px;
    }
</style>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para editar produtos.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else if (id <= 0)
{
    <p class="text-danger">ID do produto inválido.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando dados do produto...</p>
}
else if (produto == null)
{
    <p class="text-danger">Produto não encontrado ou erro ao carregar os dados.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <h3>Editar Produto</h3>

    <EditForm Model="produto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nome:</label>
            <InputText class="form-control" @bind-Value="produto.Nome" />
        </div>
        <div class="mb-3">
            <label>Marca:</label>
            <InputText class="form-control" @bind-Value="produto.Marca" />
        </div>
        <div class="mb-3">
            <label>Descrição:</label>
            <InputText class="form-control" @bind-Value="produto.Descricao" />
        </div>
        <div class="mb-3">
            <label>Categoria:</label>
            @if (!parentCategorias.Any())
            {
                <p class="text-danger">Nenhuma categoria disponível. Por favor, crie uma categoria primeiro.</p>
            }
            else
            {
                <select class="form-select" @bind="selectedParentCategoriaId" @bind:event="onchange">
                    @foreach (var cat in parentCategorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nome</option>
                    }
                </select>
            }
        </div>
        @if (subCategorias.Any())
        {
            <div class="mb-3 subcategory-container visible">
                <label>Subcategoria:</label>
                <select class="form-select" @bind="selectedSubCategoriaId">
                    <option value="0">Nenhuma subcategoria</option>
                    @foreach (var subCat in subCategorias)
                    {
                        <option value="@subCat.CategoriaId">@subCat.NomeExibicao</option>
                    }
                </select>
                @if (selectedSubCategoriaId != 0)
                {
                    var selectedSubCat = subCategorias.FirstOrDefault(c => c.CategoriaId == selectedSubCategoriaId);
                    <p class="mt-2 text-muted">Subcategoria selecionada: @(selectedSubCat?.NomeExibicao?.TrimStart(' ', '└') ?? "Desconhecida")</p>
                }
            </div>
        }
        <button type="submit" class="btn btn-primary" disabled="@(!parentCategorias.Any())">Guardar Alterações</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Voltar">Voltar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int id { get; set; }
    private Produto? produto;
    private List<Categoria> categorias = new();
    private List<Categoria> parentCategorias = new();
    private List<CategoriaSubcategorias> subCategorias = new();
    private int selectedParentCategoriaId = 0;
    private int selectedSubCategoriaId = 0;
    private bool isInitialized = false;
    private bool shouldRedirect = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (id <= 0)
        {
            ShowPopup("ID do produto inválido.", MessagePopup.MessageType.Error);
            isInitialized = true;
            return;
        }

        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                // Carrega a lista de categorias
                var catResponse = await Http.GetAsync("api/Categorias");
                if (catResponse.IsSuccessStatusCode)
                {
                    var apiResponse = await catResponse.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                    if (apiResponse?.Success == true)
                    {
                        categorias = apiResponse.Data ?? new List<Categoria>();
                        parentCategorias = categorias.Where(c => c.ParentId == null).OrderBy(c => c.Nome).ToList();
                    }
                    else
                    {
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar as categorias.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }

                // Carrega o produto
                var prodResponse = await Http.GetAsync($"api/Produtos/{id}");
                if (prodResponse.IsSuccessStatusCode)
                {
                    var apiResponse = await prodResponse.Content.ReadFromJsonAsync<ApiResponse<Produto>>();
                    if (apiResponse?.Success == true && apiResponse.Data != null)
                    {
                        produto = apiResponse.Data;
                        if (produto.Categoria != null)
                        {
                            produto.CategoriaId = produto.Categoria.CategoriaId;
                            produto.Categoria = null;
                        }

                        // Determina a categoria pai e subcategoria do produto
                        var categoriaProduto = FindCategoriaById(categorias, produto.CategoriaId);
                        if (categoriaProduto != null)
                        {
                            if (categoriaProduto.ParentId == null)
                            {
                                selectedParentCategoriaId = categoriaProduto.CategoriaId;
                                selectedSubCategoriaId = 0;
                            }
                            else
                            {
                                selectedParentCategoriaId = categoriaProduto.ParentId ?? 0;
                                selectedSubCategoriaId = categoriaProduto.CategoriaId;
                            }

                            // Carrega as subcategorias da categoria pai
                            var parentCategoria = categorias.FirstOrDefault(c => c.CategoriaId == selectedParentCategoriaId);
                            if (parentCategoria != null && parentCategoria.SubCategorias?.Any() == true)
                            {
                                subCategorias = CategoriaSubcategorias.Achatadas(parentCategoria.SubCategorias);
                            }
                        }
                        else if (parentCategorias.Any())
                        {
                            // Se a categoria do produto não for encontrada, seleciona a primeira categoria pai
                            selectedParentCategoriaId = parentCategorias.First().CategoriaId;
                            await OnParentCategoriaChanged(new ChangeEventArgs { Value = selectedParentCategoriaId.ToString() });
                        }
                    }
                    else
                    {
                        produto = null;
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar o produto.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    produto = null;
                    ShowPopup("Erro ao carregar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
            catch (Exception ex)
            {
                produto = null;
                ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
            }
            finally
            {
                isInitialized = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private Categoria? FindCategoriaById(List<Categoria> cats, int categoriaId)
    {
        foreach (var cat in cats)
        {
            if (cat.CategoriaId == categoriaId)
                return cat;
            if (cat.SubCategorias?.Any() == true)
            {
                var found = FindCategoriaById(cat.SubCategorias, categoriaId);
                if (found != null)
                    return found;
            }
        }
        return null;
    }

    private async Task OnParentCategoriaChanged(ChangeEventArgs e)
    {
        selectedParentCategoriaId = int.Parse(e.Value?.ToString() ?? "0");
        selectedSubCategoriaId = 0; // Resetar a subcategoria ao mudar a categoria pai
        subCategorias.Clear();

        if (selectedParentCategoriaId != 0)
        {
            var selectedParent = categorias.FirstOrDefault(c => c.CategoriaId == selectedParentCategoriaId);
            if (selectedParent != null)
            {
                if (selectedParent.SubCategorias?.Any() == true)
                {
                    subCategorias = CategoriaSubcategorias.Achatadas(selectedParent.SubCategorias);
                }
                else
                {
                    subCategorias.Clear();
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSubmit()
    {
        if (produto == null) return;

        if (string.IsNullOrWhiteSpace(produto.Nome))
        {
            ShowPopup("O nome do produto é obrigatório.", MessagePopup.MessageType.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(produto.Marca))
        {
            ShowPopup("A marca do produto é obrigatória.", MessagePopup.MessageType.Error);
            return;
        }

        if (selectedParentCategoriaId == 0)
        {
            ShowPopup("Selecione uma categoria válida.", MessagePopup.MessageType.Error);
            return;
        }

        try
        {
            // Usa a subcategoria se selecionada, caso contrário usa a categoria pai
            produto.CategoriaId = selectedSubCategoriaId != 0 ? selectedSubCategoriaId : selectedParentCategoriaId;
            produto.Categoria = null;


            var response = await Http.PutAsJsonAsync($"api/Produtos/{id}", produto);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                shouldRedirect = true;
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
            }
            else
            {
                ShowPopup(apiResponse?.Message ?? "Erro ao atualizar o produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo($"/products?successMessage={Uri.EscapeDataString("Produto atualizado com sucesso!")}");
            shouldRedirect = false;
        }
    }

    private void Voltar() => Navigation.NavigateTo("/products");

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
