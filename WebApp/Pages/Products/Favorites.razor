@page "/favorites"
@using WebApp.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Produtos Favoritos</PageTitle>
<h3>Produtos Favoritos</h3>

@if (!AuthService.IsLoggedIn)
{
    <p>Você precisa estar logado para visualizar seus produtos favoritos.</p>
    <button class="btn btn-primary" @onclick="NavigateToLogin">Ir para Login</button>
}
else if (!isInitialized)
{
    <p>Carregando produtos favoritos...</p>
}
else if (favoritos == null || favoritos.Count == 0)
{
    <p>Você ainda não tem produtos favoritados.</p>
    <button class="btn btn-secondary" @onclick="GoBackToProfile">Voltar ao Perfil</button>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome do Produto</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var favorito in favoritos)
            {
                <tr>
                    <td>@favorito.FavoritoId</td>
                    <td>@favorito.ProdutoNome</td>
                    <td>
                        <a href="/productdetails/@favorito.ProdutoId" class="btn btn-primary btn-sm">Ver Detalhes</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-secondary" @onclick="GoBackToProfile">Voltar ao Perfil</button>
}

@code {
    private List<FavoritoDto> favoritos = new();
    private bool isInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken() || !AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/Favoritos/user/{AuthService.UserId}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<FavoritoDto>>>();
                if (apiResponse?.Success == true)
                {
                    favoritos = apiResponse.Data ?? new List<FavoritoDto>();
                }
                else
                {
                    favoritos = new List<FavoritoDto>();
                }
            }
            else
            {
                favoritos = new List<FavoritoDto>();
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            }
        }
        catch (Exception)
        {
            favoritos = new List<FavoritoDto>();
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void GoBackToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }

    private class FavoritoDto
    {
        public int FavoritoId { get; set; }
        public int ProdutoId { get; set; }
        public string ProdutoNome { get; set; } = string.Empty;
    }
}
