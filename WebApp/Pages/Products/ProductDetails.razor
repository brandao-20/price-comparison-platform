@page "/productdetails/{Id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Detalhes do Produto</PageTitle>

<h3>Detalhes do Produto</h3>

@if (Id <= 0)
{   
    <p class="text-danger">ID do produto inválido.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando dados do produto...</p>
}
else if (produto == null)
{
    <p class="text-danger">Produto não encontrado ou erro ao carregar os dados.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@produto.Nome</h4>
            <p class="card-text"><strong>Marca:</strong> @produto.Marca</p>
            <p class="card-text"><strong>Descrição:</strong> @produto.Descricao</p>
            <p class="card-text"><strong>Categoria:</strong> @produto.Categoria?.Nome</p>
            @if (credibilidade.HasValue)
            {
                <p class="card-text">
                    <strong>Credibilidade:</strong>
                    <span class="badge @GetAdjustedCredibilityClass(credibilidade.Value)" 
                          title="A credibilidade é ajustada com base na antiguidade dos preços registrados. Valores mais recentes aumentam a credibilidade.">
                        @credibilidade.Value.ToString("F2") (ajustada por antiguidade)
                    </span>
                </p>
            }
            else
            {
                <p class="card-text"><strong>Credibilidade:</strong> Não disponível</p>
            }
            @if (AuthService.IsLoggedIn)
            {
                <button class="btn btn-primary btn-sm mt-2" @onclick="ToggleFavorite">
                    @(isFavorite ? "Remover Favorito" : "Favoritar")
                </button>
            }
        </div>
    </div>

    <h4 class="mt-4">Gráfico de Evolução de Preços</h4>
    @if (isLoadingChart)
    {
        <p>Carregando gráfico...</p>
    }
    else if (historicoPrecos != null && historicoPrecos.Any() && historicoPrecos.Any(h => h.Prices != null && h.Prices.Any()))
    {
        <div style="max-width: 800px; margin: auto;" id="chartContainer">
            <canvas id="priceChart" style="max-height: 400px;"></canvas>
        </div>
    }
    else
    {
        <p>Sem histórico de preços disponível para este produto.</p>
    }

    <h4 class="mt-4">Registos de Preços</h4>

    @if (registosPrecos == null || registosPrecos.Count == 0)
    {
        <p>Nenhum registo de preço encontrado para este produto.</p>
    }
    else
    {
        <div class="mb-3">
            <button class="btn btn-secondary" @onclick="ToggleHistory">
                @(showHistory ? "Exibir apenas preços mais recentes" : "Ver Histórico Completo")
            </button>
        </div>

        @if (showHistory)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Loja</th>
                        <th>Preço</th>
                        <th>Data</th>
                        <th>Credibilidade</th>
                        @if (AuthService.IsLoggedIn)
                        {
                            <th>Ações</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registo in registosPrecos.OrderByDescending(r => r.DataRegisto))
                    {
                        <tr>
                            <td>@registo.LojaNome</td>
                            <td>@registo.Preco.ToString("C")</td>
                            <td>@registo.DataRegisto.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="@GetCredibilidadeClass(registo.Credibilidade)">
                                    @(registo.Credibilidade >= 0.8m ? "Alta" 
                                      : registo.Credibilidade >= 0.5m ? "Média" 
                                      : "Baixa")
                                </span>
                            </td>
                            @if (AuthService.IsLoggedIn)
                            {
                                <td>
                                    <a href="/updateprice/@registo.RegistoPrecoId" class="btn btn-sm btn-warning">
                                        Atualizar Preço
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Loja</th>
                        <th>Preço</th>
                        <th>Data</th>
                        <th>Credibilidade</th>
                        @if (AuthService.IsLoggedIn)
                        {
                            <th>Ações</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registo in DistinctByLojaRegistos)
                    {
                        <tr>
                            <td>@registo.LojaNome</td>
                            <td>@registo.Preco.ToString("C")</td>
                            <td>@registo.DataRegisto.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="@GetCredibilidadeClass(registo.Credibilidade)">
                                    @(registo.Credibilidade >= 0.8m ? "Alta" 
                                      : registo.Credibilidade >= 0.5m ? "Média" 
                                      : "Baixa")
                                </span>
                            </td>
                            @if (AuthService.IsLoggedIn)
                            {
                                <td>
                                    <a href="/updateprice/@registo.RegistoPrecoId" class="btn btn-sm btn-warning">
                                        Atualizar Preço
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <button class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
}

<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;
    private List<RegistosPreco>? registosPrecos;
    private List<PriceHistoryDto>? historicoPrecos;
    private double? credibilidade;
    private List<RegistosPreco> DistinctByLojaRegistos = new();
    private bool showHistory = false;
    private bool isInitialized = false;
    private bool isLoadingChart = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool isFavorite = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id <= 0)
        {
            ShowPopup("ID do produto inválido.", MessagePopup.MessageType.Error);
            isInitialized = true;
            return;
        }

        try
        {
            var prodResponse = await Http.GetAsync($"api/Produtos/{Id}");
            if (prodResponse.IsSuccessStatusCode)
            {
                var apiResponse = await prodResponse.Content.ReadFromJsonAsync<ApiResponse<Produto>>();
                if (apiResponse?.Success == true)
                {
                    produto = apiResponse.Data;
                }
                else
                {
                    produto = null;
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os detalhes do produto.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                produto = null;
                ShowPopup("Erro ao carregar os detalhes do produto. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            var credibilidadeResponse = await Http.GetAsync($"api/Produtos/{Id}/credibilidade");
            if (credibilidadeResponse.IsSuccessStatusCode)
            {
                var apiResponse = await credibilidadeResponse.Content.ReadFromJsonAsync<ApiResponse<CredibilidadeResponse>>();
                if (apiResponse?.Success == true)
                {
                    credibilidade = apiResponse.Data?.Credibilidade;
                }
                else
                {
                    credibilidade = null;
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar a credibilidade.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                credibilidade = null;
                ShowPopup("Erro ao carregar a credibilidade. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            var regResponse = await Http.GetAsync($"api/RegistosPrecos/produto/{Id}");
            if (regResponse.IsSuccessStatusCode)
            {
                var apiResponse = await regResponse.Content.ReadFromJsonAsync<ApiResponse<List<RegistosPreco>>>();
                if (apiResponse?.Success == true)
                {
                    registosPrecos = apiResponse.Data ?? new List<RegistosPreco>();
                    DistinctByLojaRegistos = registosPrecos
                        .GroupBy(r => r.LojaId)
                        .Select(g => g.OrderByDescending(x => x.DataRegisto).First())
                        .OrderByDescending(r => r.DataRegisto)
                        .ToList();
                }
                else
                {
                    registosPrecos = new List<RegistosPreco>();
                    DistinctByLojaRegistos = new List<RegistosPreco>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os registos de preços.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                registosPrecos = new List<RegistosPreco>();
                DistinctByLojaRegistos = new List<RegistosPreco>();
                ShowPopup("Erro ao carregar os registos de preços. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            if (AuthService.IsLoggedIn)
            {
                var favoritoResponse = await Http.GetAsync($"api/Favoritos/user/{AuthService.UserId}");
                if (favoritoResponse.IsSuccessStatusCode)
                {
                    var favoritoApiResponse = await favoritoResponse.Content.ReadFromJsonAsync<ApiResponse<List<Favorito>>>();
                    if (favoritoApiResponse?.Success == true)
                    {
                        isFavorite = favoritoApiResponse.Data?.Any(f => f.ProdutoId == Id) ?? false;
                    }
                    else
                    {
                        ShowPopup(favoritoApiResponse?.Message ?? "Erro ao verificar favoritos.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    ShowPopup("Erro ao verificar favoritos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }

            // Carregar os dados do gráfico
            await CarregarDadosGrafico();
        }
        catch (Exception ex)
        {
            produto = null;
            registosPrecos = new List<RegistosPreco>();
            DistinctByLojaRegistos = new List<RegistosPreco>();
            credibilidade = null;
            ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CarregarDadosGrafico()
    {
        isLoadingChart = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var historyResponse = await Http.GetAsync($"api/Relatorios/produtos/{Id}/pricehistory?groupByStore=true");

            if (historyResponse.IsSuccessStatusCode)
            {
                var historyApiResponse = await historyResponse.Content.ReadFromJsonAsync<ApiResponse<List<PriceHistoryDto>>>();
                if (historyApiResponse?.Success == true)
                {
                    historicoPrecos = historyApiResponse.Data;

                    if (historicoPrecos == null || !historicoPrecos.Any(h => h.Prices != null && h.Prices.Any()))
                    {
                        ShowPopup("Nenhum histórico de preços disponível para este produto.", MessagePopup.MessageType.Info);
                    }
                }
                else
                {
                    ShowPopup(historyApiResponse?.Message ?? "Erro ao carregar o histórico de preços.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                var errorContent = await historyResponse.Content.ReadAsStringAsync();
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
                ShowPopup("Erro ao carregar o histórico de preços.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            ShowPopup($"Erro ao carregar o gráfico de preços: {ex.Message}", MessagePopup.MessageType.Error);
            historicoPrecos = null;
        }
        finally
        {
            isLoadingChart = false;
            await InvokeAsync(StateHasChanged);
            if (historicoPrecos != null && historicoPrecos.Any(h => h.Prices != null && h.Prices.Any()))
            {
                await RenderizarGrafico();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isInitialized && produto != null && historicoPrecos != null && historicoPrecos.Any(h => h.Prices != null && h.Prices.Any()))
        {
            await RenderizarGrafico();
        }
    }

    private async Task RenderizarGrafico()
    {
        try
        {
            var canvasExists = await JSRuntime.InvokeAsync<bool>("eval", "!!document.getElementById('priceChart')");

            if (canvasExists)
            {
                await JSRuntime.InvokeVoidAsync("renderPriceChart", historicoPrecos);
            }
            else
            {
                ShowPopup("Erro ao renderizar o gráfico: elemento canvas não encontrado.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception)
        {
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            ShowPopup("Erro ao renderizar o gráfico.", MessagePopup.MessageType.Error);
        }
    }

    private async Task ToggleFavorite()
    {
        if (!AuthService.IsLoggedIn)
        {
            ShowPopup("Faça login para favoritar produtos.", MessagePopup.MessageType.Error);
            return;
        }

        try
        {
            var favorito = new Favorito { ProdutoId = Id, UtilizadorId = AuthService.UserId };
            var response = await Http.PostAsJsonAsync("api/Favoritos", favorito);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                if (apiResponse?.Success == true)
                {
                    isFavorite = !isFavorite;
                    ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao favoritar/desfavoritar o produto.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ShowPopup($"Erro ao favoritar/desfavoritar o produto: Status {response.StatusCode}", MessagePopup.MessageType.Error);
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao favoritar/desfavoritar: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleHistory()
    {
        showHistory = !showHistory;
    }

    private string GetCredibilidadeClass(decimal credibilidade)
    {
        if (credibilidade >= 0.8m) return "badge bg-success"; // Alta
        if (credibilidade >= 0.5m) return "badge bg-warning"; // Média
        return "badge bg-danger"; // Baixa
    }

    private string GetAdjustedCredibilityClass(double cred)
    {
        if (cred >= 0.75) return "bg-success";
        if (cred >= 0.5) return "bg-warning";
        return "bg-danger";
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/products");
    }

    private class CredibilidadeResponse
    {
        public double Credibilidade { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }

    private class PriceHistoryDto
    {
        public string? LojaNome { get; set; }
        public List<PricePoint>? Prices { get; set; }
    }

    private class PricePoint
    {
        public DateTime Date { get; set; }
        public decimal Price { get; set; }
    }
}
