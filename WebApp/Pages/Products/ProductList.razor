@page "/products"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject WebApp.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Lista de Produtos</PageTitle>
<h3>Lista de Produtos</h3>

@if (!isInitialized)
{
    <p>Carregando produtos...</p>
}
else if (produtos == null || !produtos.Any())
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <div class="mb-3">
        @if (AuthService.IsLoggedIn)
        {
            <button class="btn btn-primary me-2" @onclick="IrParaCriarProduto">Criar Novo Produto</button>
            <a href="/prices/new" class="btn btn-primary">Registar Preço</a>
        }
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Marca</th>
                <th>Categoria</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in produtos)
            {
                <tr>
                    <td>@prod.ProdutoId</td>
                    <td>@prod.Nome</td>
                    <td>@prod.Marca</td>
                    <td>@prod.Categoria?.Nome</td>
                    <td>
                        <a href="/productdetails/@prod.ProdutoId" class="btn btn-info btn-sm me-2">Ver Detalhes</a>
                        @if (AuthService.IsAdmin || AuthService.IsManager)
                        {
                            <button class="btn btn-sm btn-warning me-2" @onclick="@(() => Editar(prod.ProdutoId))">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmarExclusao(prod.ProdutoId, prod.Nome))">Excluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
        <span>Página @currentPage de @totalPages</span>
        <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próximo</button>
    </div>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<!-- Popup de Confirmação para Exclusão -->
@if (showConfirmPopup)
{
    <div class="confirm-overlay">
        <div class="confirm-content">
            <h5 style="color: #d32f2f;">Confirmação</h5>
            <p style="color: #333;">Tem certeza que deseja excluir o produto "@produtoNomeToDelete"?</p>
            <div class="confirm-buttons">
                <button class="btn btn-danger" @onclick="Excluir">Sim</button>
                <button class="btn btn-secondary" @onclick="FecharConfirmPopup">Não</button>
            </div>
        </div>
    </div>
}

<style>
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .confirm-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .confirm-content h5 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .confirm-content p {
        margin: 0 0 20px 0;
        font-size: 16px;
    }

    .confirm-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .confirm-buttons .btn {
        padding: 8px 20px;
        font-size: 14px;
    }
</style>

@code {
    private List<Produto>? produtos;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;
    private bool isInitialized = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool showConfirmPopup = false;
    private int? produtoIdToDelete = null;
    private string produtoNomeToDelete = "";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var successMessage = query["successMessage"];
        if (!string.IsNullOrEmpty(successMessage))
        {
            ShowPopup(successMessage, MessagePopup.MessageType.Success);
        }

        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        try
        {
            var response = await Http.GetAsync($"api/Produtos?page={currentPage}&pageSize={pageSize}");

            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Produto>>>();
                if (apiResponse?.Success == true)
                {
                    produtos = apiResponse.Data ?? new List<Produto>();
                    var totalItemsHeader = response.Headers.GetValues("X-Total-Count").FirstOrDefault();
                    if (int.TryParse(totalItemsHeader, out int totalItems))
                    {
                        totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    }
                    else
                    {
                        totalPages = 1;
                    }
                }
                else
                {
                    produtos = new List<Produto>();
                    totalPages = 1;
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os produtos.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                produtos = new List<Produto>();
                totalPages = 1;
                var errorContent = await response.Content.ReadAsStringAsync();
                ShowPopup($"Erro ao carregar os produtos: {errorContent}", MessagePopup.MessageType.Error);
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            }
        }
        catch (Exception ex)
        {
            produtos = new List<Produto>();
            totalPages = 1;
            ShowPopup($"Erro inesperado ao carregar os produtos: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await CarregarProdutos();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await CarregarProdutos();
        }
    }

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private void IrParaCriarProduto()
    {
        if (!AuthService.IsLoggedIn)
        {
            ShowPopup("Faça login para criar um novo produto.", MessagePopup.MessageType.Error);
            return;
        }
        Navigation.NavigateTo("/products/new");
    }

    private void Editar(int id)
    {
        if (id <= 0)
        {
            ShowPopup("ID do produto inválido.", MessagePopup.MessageType.Error);
            return;
        }
        Navigation.NavigateTo($"/products/edit/{id}");
    }

    private void ConfirmarExclusao(int id, string nome)
    {
        if (id <= 0)
        {
            ShowPopup("ID do produto inválido.", MessagePopup.MessageType.Error);
            return;
        }
        produtoIdToDelete = id;
        produtoNomeToDelete = nome;
        showConfirmPopup = true;
    }

    private async Task Excluir()
    {
        if (produtoIdToDelete == null || produtoIdToDelete <= 0)
        {
            ShowPopup("ID do produto inválido.", MessagePopup.MessageType.Error);
            showConfirmPopup = false;
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/Produtos/{produtoIdToDelete}");
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
                await CarregarProdutos();
            }
            else
            {
                ShowPopup(apiResponse?.Message ?? "Erro ao excluir o produto.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao excluir o produto: {ex.Message}", MessagePopup.MessageType.Error);
        }
        finally
        {
            showConfirmPopup = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void FecharConfirmPopup()
    {
        showConfirmPopup = false;
        produtoIdToDelete = null;
        produtoNomeToDelete = "";
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
