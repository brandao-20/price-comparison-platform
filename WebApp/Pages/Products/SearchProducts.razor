@page "/searchproducts"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<h3>Pesquisar Produtos</h3>

@if (!isInitialized)
{
    <p>Carregando opções de pesquisa...</p>
}
else
{
    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-outline-primary me-3" @onclick="ToggleFilters">
            <i class="bi bi-funnel me-1"></i> @(showFilters ? "Ocultar Filtros" : "Mostrar Filtros")
        </button>
        <button class="btn btn-primary" @onclick="HandleSearch" disabled="@(!CanSearch)">
            <i class="bi bi-search me-1"></i> Pesquisar
        </button>
    </div>

    @if (showFilters)
    {
        <div class="advanced-filters card p-4 mb-4 shadow-sm">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="useName" class="form-check-input" id="chkName" />
                        <label class="form-check-label" for="chkName">Nome</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="useCategory" class="form-check-input" id="chkCategory" />
                        <label class="form-check-label" for="chkCategory">Categoria</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="useStore" class="form-check-input" id="chkStore" />
                        <label class="form-check-label" for="chkStore">Loja</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="useDate" class="form-check-input" id="chkDate" />
                        <label class="form-check-label" for="chkDate">Data (a partir de)</label>
                    </div>
                </div>
                @if (AuthService.IsLoggedIn)
                {
                    <div class="col-md-3 mt-3">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="useFavorites" class="form-check-input" id="chkFavorites" />
                            <label class="form-check-label" for="chkFavorites">Apenas Favoritos</label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="row">
            @if (useName)
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nome:</label>
                    <InputText class="form-control" @bind-Value="searchCriteria.Name" @oninput="OnNameInput" placeholder="Digite o nome do produto" />
                </div>
            }
            @if (useCategory)
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label">Categoria:</label>
                    @if (categoriasPlanas == null || !categoriasPlanas.Any())
                    {
                        <p class="text-danger">Nenhuma categoria disponível.</p>
                    }
                    else
                    {
                        <select class="form-select" @bind="searchCriteria.CategoryId">
                            <option value="">Selecione uma categoria</option>
                            @foreach (var cat in categoriasPlanas)
                            {
                                <option value="@cat.CategoriaId">@cat.NomeExibicao</option>
                            }
                        </select>
                    }
                </div>
            }
            @if (useStore)
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nome da Loja:</label>
                    <InputText class="form-control" @bind-Value="searchCriteria.Store" @oninput="OnStoreInput" placeholder="Digite o nome da loja" />
                </div>
            }
            @if (useDate)
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label">Data (a partir de):</label>
                    <InputDate class="form-control" @bind-Value="searchCriteria.DateFrom" />
                </div>
            }
        </div>
    }

    @if (isSearching)
    {
        <p class="mt-3">Pesquisando...</p>
    }
    else if (products == null)
    {
        <p class="mt-3">Realize a pesquisa para ver os resultados.</p>
    }
    else if (!products.Any())
    {
        <p class="mt-3">Nenhum produto encontrado.</p>
    }
    else
    {
        <div class="table-responsive mt-4">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Marca</th>
                        <th>Categoria</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in products)
                    {
                        <tr>
                            <td>@prod.ProdutoId</td>
                            <td>@prod.Nome</td>
                            <td>@prod.Marca</td>
                            <td>@prod.Categoria?.Nome</td>
                            <td>
                                <a href="/productdetails/@prod.ProdutoId" class="btn btn-info btn-sm">Ver Detalhes</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

<style>
    .advanced-filters {
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .form-check {
        margin-bottom: 10px;
    }

    .form-label {
        font-weight: 500;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        transition: background-color 0.3s;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }

    .btn-outline-primary {
        transition: background-color 0.3s, color 0.3s;
    }

    .btn-outline-primary:hover {
        background-color: #007bff;
        color: white;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .table-dark th {
        background-color: #343a40;
        color: white;
    }
</style>

@code {
    private bool showFilters;
    private bool useName;
    private bool useCategory;
    private bool useStore;
    private bool useDate;
    private bool useFavorites;
    private List<Produto> products = new List<Produto>();
    private List<Categoria>? categorias;
    private List<CategoriaSubcategorias> categoriasPlanas = new();
    private List<int> favoriteProductIds = new List<int>();
    private SearchCriteria searchCriteria = new SearchCriteria();
    private bool isInitialized = false;
    private bool isSearching = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Carregar categorias para o filtro
            var response = await Http.GetAsync("api/Categorias");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Categoria>>>();
                if (apiResponse?.Success == true)
                {
                    categorias = apiResponse.Data ?? new List<Categoria>();
                    categoriasPlanas = CategoriaSubcategorias.Achatadas(categorias);
                }
                else
                {
                    categorias = new List<Categoria>();
                    categoriasPlanas = new List<CategoriaSubcategorias>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar as categorias.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                categorias = new List<Categoria>();
                categoriasPlanas = new List<CategoriaSubcategorias>();
                ShowPopup("Erro ao carregar as categorias. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Carregar produtos favoritos se o utilizador estiver autenticado
            if (AuthService.IsLoggedIn)
            {
                var favoritoResponse = await Http.GetAsync($"api/Favoritos/user/{AuthService.UserId}");
                if (favoritoResponse.IsSuccessStatusCode)
                {
                    var favoritoApiResponse = await favoritoResponse.Content.ReadFromJsonAsync<ApiResponse<List<Favorito>>>();
                    if (favoritoApiResponse?.Success == true)
                    {
                        favoriteProductIds = favoritoApiResponse.Data?.Select(f => f.ProdutoId).ToList() ?? new List<int>();
                    }
                    else
                    {
                        ShowPopup(favoritoApiResponse?.Message ?? "Erro ao carregar favoritos.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    ShowPopup("Erro ao carregar favoritos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            categorias = new List<Categoria>();
            categoriasPlanas = new List<CategoriaSubcategorias>();
            ShowPopup($"Erro inesperado ao carregar as categorias: {ex.Message}", MessagePopup.MessageType.Error);
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
        StateHasChanged();
    }

    private void OnNameInput(ChangeEventArgs e)
    {
        searchCriteria.Name = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private void OnStoreInput(ChangeEventArgs e)
    {
        searchCriteria.Store = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private async Task HandleSearch()
    {
        if (!CanSearch)
        {
            ShowPopup("Selecione e preencha pelo menos um critério de pesquisa.", MessagePopup.MessageType.Error);
            return;
        }

        isSearching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (useFavorites && AuthService.IsLoggedIn && favoriteProductIds.Any() && 
                !useName && !useCategory && !useStore && !useDate)
            {
                // Apenas filtro de favoritos ativo
                var response = await Http.GetAsync($"api/Produtos/favorites/{AuthService.UserId}");
                if (response.IsSuccessStatusCode)
                {
                    var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Produto>>>();
                    if (apiResponse?.Success == true)
                    {
                        products = apiResponse.Data ?? new List<Produto>();
                    }
                    else
                    {
                        products = new List<Produto>();
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar produtos favoritos.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    products = new List<Produto>();
                    ShowPopup("Erro ao carregar produtos favoritos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                // Pesquisa com outros filtros
                var query = new List<string>();
                if (useName && !string.IsNullOrEmpty(searchCriteria.Name))
                    query.Add($"nome={Uri.EscapeDataString(searchCriteria.Name)}");
                if (useCategory && searchCriteria.CategoryId.HasValue && searchCriteria.CategoryId != 0)
                    query.Add($"categoriaId={searchCriteria.CategoryId.Value}");
                if (useStore && !string.IsNullOrEmpty(searchCriteria.Store))
                    query.Add($"store={Uri.EscapeDataString(searchCriteria.Store)}");
                if (useDate && searchCriteria.DateFrom.HasValue)
                    query.Add($"dateFrom={searchCriteria.DateFrom.Value:yyyy-MM-dd}");

                var queryString = string.Join("&", query);

                var response = await Http.GetAsync($"api/Produtos/search?{queryString}");
                var responseContent = await response.Content.ReadAsStringAsync();

                if (response.IsSuccessStatusCode)
                {
                    var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<Produto>>>();
                    if (apiResponse?.Success == true)
                    {
                        var fetchedProducts = apiResponse.Data ?? new List<Produto>();

                        // Filtrar pelos favoritos se o filtro estiver ativo
                        if (useFavorites && AuthService.IsLoggedIn && favoriteProductIds.Any())
                        {
                            products = fetchedProducts.Where(p => favoriteProductIds.Contains(p.ProdutoId)).ToList();
                            if (!products.Any())
                            {
                                ShowPopup("Nenhum produto favorito encontrado com os critérios fornecidos.", MessagePopup.MessageType.Info);
                            }
                        }
                        else
                        {
                            products = fetchedProducts;
                        }

                        if (!products.Any() && !useFavorites)
                        {
                            ShowPopup("Nenhum produto encontrado com os critérios fornecidos.", MessagePopup.MessageType.Info);
                        }
                    }
                    else
                    {
                        products = new List<Produto>();
                        ShowPopup(apiResponse?.Message ?? "Erro ao realizar a pesquisa.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    products = new List<Produto>();
                    ShowPopup("Erro ao realizar a pesquisa. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            products = new List<Produto>();
            ShowPopup($"Erro inesperado ao realizar a pesquisa: {ex.Message}", MessagePopup.MessageType.Error);
        }
        finally
        {
            isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool CanSearch =>
        (useName && !string.IsNullOrEmpty(searchCriteria.Name)) ||
        (useCategory && searchCriteria.CategoryId.HasValue && searchCriteria.CategoryId != 0) ||
        (useStore && !string.IsNullOrEmpty(searchCriteria.Store)) ||
        (useDate && searchCriteria.DateFrom.HasValue) ||
        (useFavorites && AuthService.IsLoggedIn && favoriteProductIds.Any());

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class SearchCriteria
    {
        public string Name { get; set; } = "";
        public int? CategoryId { get; set; }
        public string Store { get; set; } = "";
        public DateTime? DateFrom { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
