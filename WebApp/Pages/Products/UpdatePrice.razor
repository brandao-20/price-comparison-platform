@page "/updateprice/{Id:int}"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<PageTitle>Atualizar Registo de Preço</PageTitle>
<h3>Atualizar Registo de Preço</h3>

@if (!AuthService.IsLoggedIn)
{
    <p>Você precisa estar logado para atualizar um registo de preço.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else if (Id <= 0)
{
    <p class="text-danger">ID do registo inválido.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else if (!isInitialized)
{
    <p>Carregando dados...</p>
}
else if (record == null)
{
    <p class="text-danger">Registo de preço não encontrado ou erro ao carregar os dados.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    <EditForm Model="record" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Seleção de Produto -->
        <div class="mb-3">
            <label>Produto:</label>
            @if (produtos == null || produtos.Count == 0)
            {
                <p class="text-danger">Nenhum produto disponível.</p>
            }
            else
            {
                <select class="form-select" @bind="record.ProdutoId" disabled>
                    @foreach (var p in produtos)
                    {
                        <option value="@p.ProdutoId">@p.Nome</option>
                    }
                </select>
            }
        </div>

        <!-- Seleção de Loja -->
        <div class="mb-3">
            <label>Loja:</label>
            @if (lojas == null || lojas.Count == 0)
            {
                <p class="text-danger">Nenhuma loja disponível.</p>
            }
            else
            {
                <select class="form-select" @bind="record.LojaId" disabled>
                    @foreach (var l in lojas)
                    {
                        <option value="@l.LojaId">@l.Nome</option>
                    }
                </select>
            }
        </div>

        <!-- Seleção do Tipo de Ação -->
        <div class="mb-3">
            <label>Tipo de Ação:</label>
            @if (tipoAcoes == null || tipoAcoes.Count == 0)
            {
                <p class="text-danger">Nenhum tipo de ação disponível.</p>
            }
            else
            {
                <select class="form-select" @bind="record.TipoAcaoId">
                    @foreach (var acao in tipoAcoes)
                    {
                        <option value="@acao.TipoAcaoId">@acao.Tipo</option>
                    }
                </select>
            }
        </div>

        <!-- Campo de Preço -->
        <div class="mb-3">
            <label>Preço:</label>
            <InputNumber class="form-control" @bind-Value="record.Preco" />
            <ValidationMessage For="@(() => record.Preco)" />
        </div>

        <!-- Campo de Data com validação (não permite data futura) -->
        <div class="mb-3">
            <label>Data:</label>
            <InputDate class="form-control" @bind-Value="record.DataRegisto" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
            <ValidationMessage For="@(() => record.DataRegisto)" />
        </div>

        <!-- Campo de Comentário -->
        <div class="mb-3">
            <label>Comentário (opcional):</label>
            <InputTextArea class="form-control" @bind-Value="newComment.Conteudo" placeholder="Adicione um comentário sobre este preço..." />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">Atualizar Registo</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Voltar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int Id { get; set; }
    private RegistosPreco? record;
    private List<Produto>? produtos;
    private List<Loja>? lojas;
    private List<TipoAcao>? tipoAcoes;
    private Comentario newComment = new();
    private bool isInitialized = false;
    private bool shouldRedirect = false;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken() || !AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Id <= 0)
        {
            ShowPopup("ID do registo inválido.", MessagePopup.MessageType.Error);
            isInitialized = true;
            return;
        }

        try
        {
            // Carrega o registo de preço
            var regResponse = await Http.GetAsync($"api/RegistosPrecos/{Id}");
            if (regResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            if (regResponse.IsSuccessStatusCode)
            {
                var apiResponse = await regResponse.Content.ReadFromJsonAsync<ApiResponse<RegistosPreco>>();
                if (apiResponse?.Success == true)
                {
                    record = apiResponse.Data;
                }
                else
                {
                    record = null;
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar o registo de preço.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                record = null;
                ShowPopup("Erro ao carregar o registo de preço. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Carrega a lista de produtos
            var prodResponse = await Http.GetAsync("api/Produtos");
            if (prodResponse.IsSuccessStatusCode)
            {
                var apiResponse = await prodResponse.Content.ReadFromJsonAsync<ApiResponse<List<Produto>>>();
                if (apiResponse?.Success == true)
                {
                    produtos = apiResponse.Data ?? new List<Produto>();
                }
                else
                {
                    produtos = new List<Produto>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os produtos.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                produtos = new List<Produto>();
                ShowPopup("Erro ao carregar os produtos. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Carrega a lista de lojas
            var lojaResponse = await Http.GetAsync("api/Lojas");
            if (lojaResponse.IsSuccessStatusCode)
            {
                lojas = await lojaResponse.Content.ReadFromJsonAsync<List<Loja>>() ?? new List<Loja>();
            }
            else
            {
                lojas = new List<Loja>();
                ShowPopup("Erro ao carregar as lojas. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }

            // Carrega a lista de tipos de ação
            var acaoResponse = await Http.GetAsync("api/TipoAcaos");
            if (acaoResponse.IsSuccessStatusCode)
            {
                var apiResponse = await acaoResponse.Content.ReadFromJsonAsync<ApiResponse<List<TipoAcao>>>();
                if (apiResponse?.Success == true)
                {
                    tipoAcoes = apiResponse.Data ?? new List<TipoAcao>();
                }
                else
                {
                    tipoAcoes = new List<TipoAcao>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar os tipos de ação.", MessagePopup.MessageType.Error);
                }
            }
            else
            {
                tipoAcoes = new List<TipoAcao>();
                ShowPopup("Erro ao carregar os tipos de ação. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            record = null;
            produtos = new List<Produto>();
            lojas = new List<Loja>();
            tipoAcoes = new List<TipoAcao>();
            ShowPopup($"Erro inesperado ao carregar os dados: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
        finally
        {
            isInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleSubmit()
    {
        if (record == null) return;

        if (record.ProdutoId <= 0)
        {
            ShowPopup("Selecione um produto válido.", MessagePopup.MessageType.Error);
            return;
        }

        if (record.LojaId <= 0)
        {
            ShowPopup("Selecione uma loja válida.", MessagePopup.MessageType.Error);
            return;
        }

        if (record.TipoAcaoId <= 0)
        {
            ShowPopup("Selecione um tipo de ação válido.", MessagePopup.MessageType.Error);
            return;
        }

        if (record.Preco <= 0)
        {
            ShowPopup("O preço deve ser maior que zero.", MessagePopup.MessageType.Error);
            return;
        }

        record.Produto = null;
        record.Loja = null;
        record.TipoAcao = null;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/RegistosPrecos/{Id}", record);
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                // Adicionar comentário, se houver
                if (!string.IsNullOrWhiteSpace(newComment.Conteudo))
                {
                    newComment.RegistoPrecoId = Id;
                    newComment.UtilizadorId = AuthService.UserId;
                    var commentResponse = await Http.PostAsJsonAsync("api/Comentarios", newComment);
                    if (commentResponse.IsSuccessStatusCode)
                    {
                        var commentApiResponse = await commentResponse.Content.ReadFromJsonAsync<ApiResponse<Comentario>>();
                        if (commentApiResponse?.Success == true)
                        {
                            ShowPopup("Preço atualizado e comentário adicionado com sucesso!", MessagePopup.MessageType.Success);
                        }
                        else
                        {
                            ShowPopup(commentApiResponse?.Message ?? "Preço atualizado, mas erro ao adicionar comentário.", MessagePopup.MessageType.Error);
                        }
                    }
                    else
                    {
                        ShowPopup("Preço atualizado, mas erro ao adicionar comentário.", MessagePopup.MessageType.Error);
                    }
                }
                else
                {
                    ShowPopup("Preço atualizado com sucesso!", MessagePopup.MessageType.Success);
                }
                shouldRedirect = true;
            }
            else
            {
                ShowPopup(apiResponse?.Message ?? "Erro ao atualizar o registo de preço.", MessagePopup.MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o registo de preço: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
        }
    }

    private bool CanSubmit =>
        produtos != null && produtos.Count > 0 &&
        lojas != null && lojas.Count > 0 &&
        tipoAcoes != null && tipoAcoes.Count > 0 &&
        record != null &&
        record.ProdutoId > 0 &&
        record.LojaId > 0 &&
        record.TipoAcaoId > 0 &&
        record.Preco > 0;

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo($"/products?successMessage={Uri.EscapeDataString("Registo de preço atualizado com sucesso!")}");
            shouldRedirect = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/products");

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }
}
