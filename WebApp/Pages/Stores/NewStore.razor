@page "/stores/new"
@using WebApp.Models
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<h2>Adicionar Nova Loja</h2>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para criar lojas.</p>
    <button class="btn btn-secondary" @onclick="GoBack">← Voltar</button>
}
else
{
    <div class="container-fluid">
        @if (locationObtained)
        {
            <!-- Mapa ocupando toda a área -->
            <div class="row" style="height: 500px;">
                <div class="col-12" style="height: 100%;">
                    <GoogleMap
                        Latitude="@tempLatitude"
                        Longitude="@tempLongitude"
                        OnMapClick="HandleMapClick"
                        OnMapInitialized="HandleMapInitialized" />
                </div>
            </div>
        }
        else
        {
            <p>Obtendo localização...</p>
        }

        <!-- Detalhes do supermercado selecionado -->
        @if (selectedSupermarket != null)
        {
            <div class="alert alert-info mt-3">
                <h5>Supermercado Selecionado:</h5>
                <p><strong>Nome:</strong> @(selectedSupermarket.Name ?? "Não disponível")</p>
                <p><strong>Endereço:</strong> @(selectedSupermarket.Address ?? "Não disponível")</p>
                <p><strong>Latitude:</strong> @selectedSupermarket.Lat</p>
                <p><strong>Longitude:</strong> @selectedSupermarket.Lng</p>
                <button class="btn btn-primary" @onclick="HandleSubmit">Guardar Loja</button>
                <button class="btn btn-secondary ms-2" @onclick="ClearSelection">Desmarcar</button>
            </div>
        }
    </div>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private Loja newStore = new Loja();
    private string MapId { get; set; } = Guid.NewGuid().ToString().Replace("-", "");
    private bool googleMapsLoaded = false;

    public class GeolocationResult
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }
    private decimal tempLatitude = 38.7223m;  // fallback (Lisboa)
    private decimal tempLongitude = -9.1393m; // fallback (Lisboa)
    private bool locationObtained = false;
    private SupermarketModel? selectedSupermarket;
    private DotNetObjectReference<NewStore>? _objectRef;
    private string? currentMapElementId;
    private List<Loja> existingStores = new List<Loja>();

    // Propriedades para controlar o popup
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Error;

    protected override async Task OnInitializedAsync()
    {
        newStore.Localizacao = new Localizacao
        {
            Latitude = 0m,
            Longitude = 0m
        };

        _objectRef = DotNetObjectReference.Create(this);

        // Carrega as lojas existentes para verificação de duplicatas
        await LoadExistingStoresAsync();

        // Tenta obter a localização atual do usuário
        await GetUserLocationAsync();
    }

    private async Task LoadExistingStoresAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<Loja>>("api/Lojas");
            if (response != null)
            {
                existingStores = response;
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao carregar lojas existentes: {ex.Message}", MessagePopup.MessageType.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetUserLocationAsync()
    {
        try
        {
            var apiKey = Configuration["GoogleMapsApiKey"];
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                ShowPopup("Google Maps is not configured. Store lookup is unavailable.", MessagePopup.MessageType.Error);
                return;
            }
            if (!googleMapsLoaded)
            {
                await JSRuntime.InvokeVoidAsync("mapsInterop.loadGoogleMaps", apiKey);
                googleMapsLoaded = true;
            }
            await WaitForGoogleMapsAsync();
            await WaitForMapsInteropAsync();

            // Obtém a localização do usuário
            var location = await JSRuntime.InvokeAsync<GeolocationResult>("mapsInterop.getUserLocation");
            tempLatitude = Convert.ToDecimal(location.Lat);
            tempLongitude = Convert.ToDecimal(location.Lng);
            locationObtained = true;
        }
        catch (Exception)
        {
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            tempLatitude = 38.7223m;
            tempLongitude = -9.1393m;
            locationObtained = true;
        }
    }

    private async Task HandleMapInitialized(string mapElementId)
    {
        currentMapElementId = mapElementId;

        await JSRuntime.InvokeVoidAsync("mapsInterop.focusOnSupermarket", currentMapElementId, (double)tempLatitude, (double)tempLongitude);
        
        // Busca automática de supermercados
        try
        {
            await JSRuntime.InvokeVoidAsync("mapsInterop.findNearbySupermarkets", (double)tempLatitude, (double)tempLongitude, currentMapElementId, _objectRef);
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao buscar supermercados: {ex.Message}", MessagePopup.MessageType.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WaitForGoogleMapsAsync()
    {
        int attempts = 0;
        const int maxAttempts = 200;
        while (attempts < maxAttempts)
        {
            try
            {
                var loaded = await JSRuntime.InvokeAsync<bool>("eval", "typeof google !== 'undefined' && typeof google.maps !== 'undefined' && window.googleMapsLoaded === true");
                if (loaded)
                {
                    return;
                }
            }
            catch (Exception)
            {
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            }
            await Task.Delay(100);
            attempts++;
        }
        throw new Exception("Timeout: Google Maps API não carregou após 20 segundos.");
    }

    private async Task WaitForMapsInteropAsync()
    {
        int attempts = 0;
        const int maxAttempts = 200;
        while (attempts < maxAttempts)
        {
            try
            {
                bool isUndefined = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.mapsInterop === 'undefined' || typeof window.mapsInterop.getUserLocation === 'undefined'");
                if (!isUndefined)
                {
                    return;
                }
            }
            catch (Exception)
            {
                Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            }
            await Task.Delay(100);
            attempts++;
        }
        throw new Exception("Timeout: mapsInterop.getUserLocation não foi carregado após 20 segundos.");
    }

    [JSInvokable]
    public void SelectSupermarket(SupermarketModel supermarket)
    {
        selectedSupermarket = supermarket;
        newStore.Nome = supermarket.Name;
        newStore.Endereco = supermarket.Address;
        newStore.Localizacao.Latitude = (decimal)supermarket.Lat;
        newStore.Localizacao.Longitude = (decimal)supermarket.Lng;
        newStore.PlaceId = supermarket.PlaceId; // Armazena o placeId
        tempLatitude = (decimal)supermarket.Lat;
        tempLongitude = (decimal)supermarket.Lng;
        JSRuntime.InvokeVoidAsync("mapsInterop.focusOnSupermarket", currentMapElementId, supermarket.Lat, supermarket.Lng);
        StateHasChanged();
    }

    private void ClearSelection()
    {
        selectedSupermarket = null;
        newStore.Nome = "";
        newStore.Endereco = "";
        newStore.Localizacao.Latitude = 0m;
        newStore.Localizacao.Longitude = 0m;
        newStore.PlaceId = null;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (selectedSupermarket == null)
        {
            ShowPopup("Por favor, selecione um supermercado antes de salvar.", MessagePopup.MessageType.Error);
            return;
        }

        // Log para depuração

        // Verifica se a loja já existe com base em vários critérios
        try
        {
            var existingStore = existingStores.FirstOrDefault(s =>
            {
                // Log para cada loja existente durante a verificação

                return
                    // Verifica pelo placeId (se disponível)
                    (!string.IsNullOrEmpty(s.PlaceId) && !string.IsNullOrEmpty(newStore.PlaceId) && s.PlaceId.Equals(newStore.PlaceId, StringComparison.OrdinalIgnoreCase)) ||
                    // Verifica por nome e endereço
                    (s.Nome.Equals(selectedSupermarket.Name, StringComparison.OrdinalIgnoreCase) &&
                     s.Endereco.Equals(selectedSupermarket.Address, StringComparison.OrdinalIgnoreCase)) ||
                    // Verifica por coordenadas (latitude e longitude)
                    (s.Localizacao != null && newStore.Localizacao != null &&
                     Math.Abs((s.Localizacao.Latitude ?? 0m) - (newStore.Localizacao.Latitude ?? 0m)) < 0.0001m &&
                     Math.Abs((s.Localizacao.Longitude ?? 0m) - (newStore.Localizacao.Longitude ?? 0m)) < 0.0001m);
            });

            if (existingStore != null)
            {
                ShowPopup($"Esta loja já existe no sistema. Loja ID: {existingStore.LojaId}", MessagePopup.MessageType.Error);
                await InvokeAsync(StateHasChanged);
                return;
            }
            }
        catch (Exception ex)
        {
            ShowPopup($"Erro ao verificar lojas existentes: {ex.Message}", MessagePopup.MessageType.Error);
            Console.Error.WriteLine("The operation failed. Check the API or browser network diagnostics.");
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Salva a loja se não houver duplicata
        var saveResponse = await Http.PostAsJsonAsync("api/Lojas", newStore);
        if (saveResponse.IsSuccessStatusCode)
        {
            // Atualiza a lista de lojas existentes
            existingStores.Add(newStore);
            // Redireciona para a página de listagem com a mensagem de sucesso na query string
            Navigation.NavigateTo("/admin/stores?successMessage=Loja%20criada%20com%20sucesso!");
        }
        else
        {
            var debug = await saveResponse.Content.ReadAsStringAsync();
            ShowPopup($"Erro ao criar loja: {debug}", MessagePopup.MessageType.Error);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMapClick((decimal lat, decimal lng, string address) data)
    {
        // Não usado.
    }

    private void GoBack() => Navigation.NavigateTo("/admin/stores");

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);
    }

    public class SupermarketModel
    {
        public string Name { get; set; } = "";
        public string PlaceId { get; set; } = "";
        public string Address { get; set; } = "";
        public double Lat { get; set; }
        public double Lng { get; set; }
    }
}
