@page "/users/new"
@using System.Text.RegularExpressions
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<h3>Criar Novo Utilizador</h3>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para criar utilizadores.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    <EditForm Model="novoUser" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Username:</label>
            <InputText class="form-control" @bind-Value="novoUser.Username" />
        </div>
        <div class="mb-3">
            <label>Email:</label>
            <InputText class="form-control" @bind-Value="novoUser.Email" />
        </div>
        <div class="mb-3">
            <label>Password:</label>
            <InputText type="password" class="form-control" @bind-Value="novoUser.Password" />
        </div>

        <div class="mb-3">
            <label>Cargo (TipoUtilizador):</label>
            <select class="form-select" @bind="novoUser.Tipo">
                @if (AuthService.IsAdmin)
                {
                    <option value="Admin">Admin</option>
                    <option value="UserManager">UserManager</option>
                }
                <option value="User">User</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Criar</button>
    </EditForm>
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    private UserDto novoUser = new();
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool shouldRedirect = false;

    private async Task HandleSubmit()
    {
        try
        {
            // Validações iniciais
            if (string.IsNullOrWhiteSpace(novoUser.Username))
            {
                ShowPopup("O nome de utilizador é obrigatório.", MessagePopup.MessageType.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(novoUser.Email) || !IsValidEmail(novoUser.Email))
            {
                ShowPopup("Email inválido.", MessagePopup.MessageType.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(novoUser.Password))
            {
                ShowPopup("A senha é obrigatória.", MessagePopup.MessageType.Error);
                return;
            }

            // Verificar se o username ou email já existe
            var checkResponse = await Http.GetAsync($"api/Utilizadores/check?username={Uri.EscapeDataString(novoUser.Username)}&email={Uri.EscapeDataString(novoUser.Email)}");
            if (checkResponse.IsSuccessStatusCode)
            {
                var checkResult = await checkResponse.Content.ReadFromJsonAsync<ApiResponse<CheckAvailabilityResponse>>();
                if (checkResult?.Success == true)
                {
                    if (checkResult.Data?.UsernameExists == true)
                    {
                        ShowPopup("O nome de utilizador já está em uso.", MessagePopup.MessageType.Error);
                        return;
                    }
                    if (checkResult.Data?.EmailExists == true)
                    {
                        ShowPopup("O email já está em uso.", MessagePopup.MessageType.Error);
                        return;
                    }
                }
                else
                {
                    ShowPopup(checkResult?.Message ?? "Erro ao verificar disponibilidade.", MessagePopup.MessageType.Error);
                    return;
                }
            }
            else
            {
                ShowPopup("Erro ao verificar disponibilidade de username/email.", MessagePopup.MessageType.Error);
                return;
            }

            // Enviar requisição de criação
            var response = await Http.PostAsJsonAsync("api/Utilizadores/admincreate", novoUser);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<Utilizador>>();

            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                shouldRedirect = true;
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
            }
            else
            {
                if (apiResponse?.ErrorCode == "DUPLICATE_USERNAME")
                {
                    ShowPopup("O nome de utilizador já está em uso.", MessagePopup.MessageType.Error);
                }
                else if (apiResponse?.ErrorCode == "DUPLICATE_EMAIL")
                {
                    ShowPopup("O email já está em uso.", MessagePopup.MessageType.Error);
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao criar o utilizador. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao criar o utilizador: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private bool IsValidEmail(string email)
    {
        var emailRegex = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return Regex.IsMatch(email, emailRegex);
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo($"/users?successMessage={Uri.EscapeDataString("Utilizador criado com sucesso!")}");
            shouldRedirect = false;
        }
    }

    private void Voltar() => Navigation.NavigateTo("/users");

    public class UserDto
    {
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Tipo { get; set; } = "User"; // Admin, UserManager, User
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }

    private class CheckAvailabilityResponse
    {
        public bool UsernameExists { get; set; }
        public bool EmailExists { get; set; }
    }

    private class Utilizador
    {
        public int UtilizadorId { get; set; }
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public int TipoUtilizadorId { get; set; }
        public DateTime DataCriacao { get; set; }
    }
}
