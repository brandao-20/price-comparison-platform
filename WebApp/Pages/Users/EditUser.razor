@page "/users/edit/{id:int}"
@using System.Text.RegularExpressions
@using WebApp.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject WebApp.Services.AuthService AuthService

<h3>Editar Utilizador</h3>

@if (!AuthService.IsAdmin && !AuthService.IsManager)
{
    <p>Você não tem permissão para editar utilizadores.</p>
    <button class="btn btn-secondary" @onclick="Voltar">← Voltar</button>
}
else
{
    @if (usuario == null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <EditForm Model="usuario" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Username:</label>
                <InputText class="form-control" @bind-Value="usuario.Username" />
            </div>
            <div class="mb-3">
                <label>Email:</label>
                <InputText class="form-control" @bind-Value="usuario.Email" />
            </div>
            <div class="mb-3">
                <label>Nova Password (opcional):</label>
                <InputText type="password" class="form-control" @bind-Value="novaPassword" />
            </div>

            <div class="mb-3">
                <label>Cargo (TipoUtilizador):</label>
                <select class="form-select" @bind="usuario.Tipo">
                    @if (AuthService.IsAdmin)
                    {
                        <option value="Admin">Admin</option>
                        <option value="UserManager">UserManager</option>
                    }
                    <option value="User">User</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
        </EditForm>
    }
}

<!-- Popup para mensagens -->
<MessagePopup
    IsVisible="@showPopup"
    Message="@popupMessage"
    Type="@popupType"
    OnClose="ClosePopup" />

@code {
    [Parameter] public int id { get; set; }
    private UserDto? usuario;
    private string? novaPassword;
    private bool showPopup = false;
    private string popupMessage = "";
    private MessagePopup.MessageType popupType = MessagePopup.MessageType.Success;
    private bool shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.ValidateToken())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (AuthService.IsAdmin || AuthService.IsManager)
        {
            try
            {
                var response = await Http.GetAsync($"api/Utilizadores/adminget/{id}");
                if (response.IsSuccessStatusCode)
                {
                    var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UserDto>>();
                    if (apiResponse?.Success == true)
                    {
                        usuario = apiResponse.Data;
                    }
                    else
                    {
                        ShowPopup(apiResponse?.Message ?? "Erro ao carregar o utilizador.", MessagePopup.MessageType.Error);
                        usuario = null;
                    }
                }
                else
                {
                    var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UserDto>>();
                    ShowPopup(apiResponse?.Message ?? "Erro ao carregar o utilizador. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                    usuario = null;
                }
            }
            catch (Exception ex)
            {
                ShowPopup($"Erro inesperado ao carregar o utilizador: {ex.Message}", MessagePopup.MessageType.Error);
                usuario = null;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (usuario == null) return;

        try
        {
            // Validações iniciais
            if (string.IsNullOrWhiteSpace(usuario.Username))
            {
                ShowPopup("O nome de utilizador é obrigatório.", MessagePopup.MessageType.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(usuario.Email) || !IsValidEmail(usuario.Email))
            {
                ShowPopup("Email inválido.", MessagePopup.MessageType.Error);
                return;
            }

            // Verificar se o username ou email já existe (exceto para o próprio utilizador)
            var checkResponse = await Http.GetAsync($"api/Utilizadores/check?username={Uri.EscapeDataString(usuario.Username)}&email={Uri.EscapeDataString(usuario.Email)}");
            if (checkResponse.IsSuccessStatusCode)
            {
                var checkResult = await checkResponse.Content.ReadFromJsonAsync<ApiResponse<CheckAvailabilityResponse>>();
                if (checkResult?.Success == true)
                {
                    if (checkResult.Data?.UsernameExists == true)
                    {
                        // Verificar se o username pertence a outro utilizador
                        var existingUsername = await Http.GetAsync($"api/Utilizadores/adminget/{id}");
                        var existingUser = await existingUsername.Content.ReadFromJsonAsync<ApiResponse<UserDto>>();
                        if (existingUser?.Data?.Username.ToLower() != usuario.Username.ToLower())
                        {
                            ShowPopup("O nome de utilizador já está em uso.", MessagePopup.MessageType.Error);
                            return;
                        }
                    }
                    if (checkResult.Data?.EmailExists == true)
                    {
                        // Verificar se o email pertence a outro utilizador
                        var existingEmail = await Http.GetAsync($"api/Utilizadores/adminget/{id}");
                        var existingUser = await existingEmail.Content.ReadFromJsonAsync<ApiResponse<UserDto>>();
                        if (existingUser?.Data?.Email.ToLower() != usuario.Email.ToLower())
                        {
                            ShowPopup("O email já está em uso.", MessagePopup.MessageType.Error);
                            return;
                        }
                    }
                }
                else
                {
                    ShowPopup(checkResult?.Message ?? "Erro ao verificar disponibilidade.", MessagePopup.MessageType.Error);
                    return;
                }
            }
            else
            {
                ShowPopup("Erro ao verificar disponibilidade de username/email.", MessagePopup.MessageType.Error);
                return;
            }

            usuario.NewPassword = novaPassword; // se existir
            var response = await Http.PutAsJsonAsync($"api/Utilizadores/adminedit/{id}", usuario);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (response.IsSuccessStatusCode && apiResponse?.Success == true)
            {
                shouldRedirect = true;
                ShowPopup(apiResponse.Message, MessagePopup.MessageType.Success);
            }
            else
            {
                if (apiResponse?.ErrorCode == "DUPLICATE_USERNAME")
                {
                    ShowPopup("O nome de utilizador já está em uso.", MessagePopup.MessageType.Error);
                }
                else if (apiResponse?.ErrorCode == "DUPLICATE_EMAIL")
                {
                    ShowPopup("O email já está em uso.", MessagePopup.MessageType.Error);
                }
                else
                {
                    ShowPopup(apiResponse?.Message ?? "Erro ao atualizar o utilizador. Tente novamente mais tarde.", MessagePopup.MessageType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Erro inesperado ao atualizar o utilizador: {ex.Message}", MessagePopup.MessageType.Error);
        }
    }

    private bool IsValidEmail(string email)
    {
        var emailRegex = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return Regex.IsMatch(email, emailRegex);
    }

    private void ShowPopup(string message, MessagePopup.MessageType type)
    {
        popupMessage = message;
        popupType = type;
        showPopup = true;
    }

    private async Task ClosePopup()
    {
        showPopup = false;
        await InvokeAsync(StateHasChanged);

        if (shouldRedirect)
        {
            Navigation.NavigateTo("/users");
            shouldRedirect = false;
        }
    }

    private void Voltar() => Navigation.NavigateTo("/users");

    public class UserDto
    {
        public int UtilizadorId { get; set; }
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Tipo { get; set; } = "User"; // Admin, UserManager, User
        public string? NewPassword { get; set; }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? ErrorCode { get; set; }
        public int StatusCode { get; set; }
        public T? Data { get; set; }
    }

    private class CheckAvailabilityResponse
    {
        public bool UsernameExists { get; set; }
        public bool EmailExists { get; set; }
    }
}
